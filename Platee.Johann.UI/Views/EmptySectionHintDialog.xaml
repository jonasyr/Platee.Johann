<Window x:Class="Platee.Johann.UI.Views.EmptySectionHintDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Platé.Johann – Hinweis"
        SizeToContent="Height"
        Width="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock x:Name="HeadlineText"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="#DA342B"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <TextBlock x:Name="BodyText"
                   FontSize="13"
                   TextWrapping="Wrap"
                   LineHeight="19"
                   Margin="0,0,0,18"/>

        <CheckBox x:Name="DoNotShowAgain"
                  Content="Diesen Hinweis nicht mehr anzeigen"
                  FontSize="12"
                  Margin="0,0,0,16"/>

        <Button Content="OK"
                Click="Ok_Click"
                IsDefault="True"
                HorizontalAlignment="Right"
                Padding="24,6"
                MinWidth="90"/>
    </StackPanel>
</Window>

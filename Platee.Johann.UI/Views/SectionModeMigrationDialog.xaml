<Window x:Class="Platee.Johann.UI.Views.SectionModeMigrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Platé.Johann – Abschnitte automatisch oder auf Knopfdruck?"
        SizeToContent="Height"
        Width="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Neu ab Version 1.4.0"
                   FontSize="11" FontWeight="Bold" Foreground="#999"
                   Margin="0,0,0,4"/>
        <TextBlock Text="Wie viel soll Johann automatisch erzeugen?"
                   FontSize="17" FontWeight="SemiBold"
                   Margin="0,0,0,12" TextWrapping="Wrap"/>

        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#444" Margin="0,0,0,10">
            Bisher hat Johann nach jeder Aufnahme alle Abschnitte erzeugt. Das sind acht
            Anfragen an die KI – und genau die Wartezeit, die man merkt, wenn man direkt
            davor sitzt.
        </TextBlock>

        <Border Background="#F7F7F7" BorderBrush="#E0E0E0" BorderThickness="1"
                Padding="12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#444">
                    Mit der Empfehlung werden weiterhin automatisch erzeugt:
                    <Run FontWeight="SemiBold">Zusammenfassung, Ausführliche Zusammenfassung, Aufgaben und Gesprächsnotiz.</Run>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#444" Margin="0,6,0,0">
                    <Run FontWeight="SemiBold">Stundenzettel, Analog und E-Mail</Run>
                    entstehen dann nur noch „auf Knopfdruck“: Der Abschnitt erscheint im
                    Eintrag mit einer Schaltfläche „Generieren“ und wird erst erzeugt, wenn
                    Sie ihn wirklich brauchen. (E-Mail war auch bisher schon so.)
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#777" Margin="0,0,0,16">
            Sie können das jederzeit ändern: Einstellungen → Kategorien → Automatisch / Auf Knopfdruck.
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="KeepAllButton"
                    Content="Wie bisher – alle automatisch"
                    Padding="14,7" FontSize="13" Margin="0,0,8,0"
                    Click="KeepAll_Click"/>
            <Button x:Name="RecommendedButton"
                    Content="Empfohlen – 4 Abschnitte automatisch"
                    IsDefault="True"
                    Padding="14,7" FontSize="13"
                    Background="#E63123" Foreground="White" BorderThickness="0"
                    Click="Recommended_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
